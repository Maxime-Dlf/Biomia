{
  "name": "crassecadia",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:client": "pnpm --filter @crassecadia/client dev",
    "dev:server": "pnpm --filter @crassecadia/server dev",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "pnpm --filter @crassecadia/client e2e",
    "simulate": "pnpm --filter @crassecadia/tools simulate"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "turbo": "^2.11.7",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
