# Copier en `deploy/.env` (jamais commité), puis : chmod 600 deploy/.env
#
# Nom public du site, sans https:// ni chemin.
#   Tailscale Funnel : <machine>.<tailnet>.ts.net (donné par `tailscale funnel status`)
#   Accès direct     : crassecadia-dev.duckdns.org, puis plus tard le domaine payant
DOMAIN=

# Application Discord (portail développeur). Le Client ID n'est pas secret ; le Client Secret l'est :
# il ne quitte jamais ce fichier.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Région affichée dans le navigateur de salons, budget de tuiles par salon (§12.4).
REGION=eu
ROOM_TILE_BUDGET=200000

# Accès direct uniquement (docker-compose.direct.yml) : jeton du compte DuckDNS pour la mise à jour
# de l'adresse IP (deploy/duckdns-update.sh).
DUCKDNS_TOKEN=
